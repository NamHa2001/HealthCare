{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://healthplus.vn",
      "https://app.healthplus.vn"
    ]
  },
  "Jwt": {
    "Issuer": "https://api.healthplus.vn",
    "Audience": "https://healthplus.vn",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Storage": {
    "BucketDocuments": "health-documents",
    "UseSSL": true
  },
  "Email": {
    "FromName": "Health+",
    "Port": 587
  },
  "Ocr": {
    "ConfidenceThreshold": 0.75
  },
  "Features": {
    "OcrEnabled": true,
    "FamilyGroupEnabled": true,
    "OfflineSyncEnabled": true
  }
}
