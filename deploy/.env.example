# ============================================================
# Health+ — Local Dev Environment Variables
# Copy this file to deploy/.env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- SQL Server ---
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- JWT (RS256) ---
# Generate with: openssl genrsa -out keys/jwt_private.pem 2048
#                openssl rsa -in keys/jwt_private.pem -pubout -out keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# --- Google Vision API ---
GOOGLE_VISION_API_KEY=

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=healthplus-dev
FIREBASE_CREDENTIALS_PATH=keys/firebase-credentials.json

# --- Hangfire Dashboard ---
HANGFIRE_DASHBOARD_USER=admin
HANGFIRE_DASHBOARD_PASS=admin123

# --- App URLs ---
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:4200
